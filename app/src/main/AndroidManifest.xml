<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur declares minSdk 33; every call site is guarded by an SDK/shader check. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Self-update drives PackageInstaller.Session itself: without this, createSession/commit
         throw SecurityException and the tap looks like it did nothing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MemosApplication"
        android:allowBackup="true"
        android:backupAgent=".data.backup.NativeBackupAgent"
        android:fullBackupOnly="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moxia"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Moxia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share target: one payload of any type. `*/*` already covers text and
                 images, so separate filters only added duplicates to the share sheet. -->
            <intent-filter android:label="@string/memo_composer_fab_new_memo">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Share target: multiple payloads of any type. -->
            <intent-filter android:label="@string/memo_composer_fab_new_memo">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.profile.EditProfileActivity" android:exported="false" />
        <activity android:name=".ui.profile.EditAccountCredentialsActivity" android:exported="false" />
        <activity android:name=".ui.profile.NotificationsActivity" android:exported="false" />
        <activity android:name=".ui.profile.DraftsActivity" android:exported="false" />
        <activity android:name=".ui.component.composer.MemoEditorActivity" android:exported="false" />
        <activity android:name=".ui.profile.ArchivedMemosActivity" android:exported="false" />
        <activity android:name=".ui.profile.MemoTypeMemosActivity" android:exported="false" />
        <activity android:name=".ui.profile.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.setup.SetupActivity" android:exported="false" />
        <activity android:name=".ui.setup.SetupLoginActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />
        <activity android:name=".ui.setup.SsoLoginActivity" android:exported="false" />
        <activity android:name=".ui.setup.SsoCallbackActivity" android:exported="true" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="oauth" android:path="/callback" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.backup.BackupTransferActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />
        <activity android:name=".ui.profile.OpenSourceLicensesActivity" android:exported="false" />

        <receiver
            android:name=".widget.DraftWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/draft_widget_info" />
        </receiver>

        <activity
            android:name=".widget.stats.UserStatsWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Moxia">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.stats.UserStatsWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/user_stats_widget_info" />
        </receiver>

        <!-- PackageInstaller reports the session outcome here. Not exported: the intent is built
             by this app and handed to the system as a mutable PendingIntent. -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.example.moxia.action.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Serves the PNG written for "share as image"; nothing else is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
